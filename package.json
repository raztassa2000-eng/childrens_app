{
  "name": "wonderwhirl",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An animated, AI-powered learning world for kids",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:server:dev\" \"npm:web\"",
    "web": "vite",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:run": "npm run build && cap sync ios && cap run ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource/fredoka": "^5.3.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
