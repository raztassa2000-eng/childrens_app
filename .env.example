# Required for AI generation ("Magic Maker" and the seed script).
ANTHROPIC_API_KEY=

# Natural character voices (Google Gemini text-to-speech). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# VOICE_ENGINE=cloud              # gemini (default) | cloud (Chirp 3 HD) | cloud-gemini (Gemini voices via Google Cloud)
# VOICE_ENGINE_HE=cloud-gemini    # per-language engine (here: Hebrew)
# GOOGLE_AUTH=gcloud               # sign in with your Google account (gcloud auth login) instead of API keys
# GOOGLE_CLOUD_PROJECT=            # project for billing when signed in (id or number)
# GOOGLE_TTS_API_KEY=AIza...      # standard API key with "Cloud Text-to-Speech API" enabled (for VOICE_ENGINE=cloud)
# GEMINI_TTS_RPM=10              # voice lines per minute (free plan: 10; raise it if billing is on)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium            # low | medium | high | xhigh | max
# SAFETY_REVIEW=on                # second-pass child-safety review of every AI story
# GENERATION_LIMIT_PER_HOUR=20    # per-IP limit on new AI generations
# PORT=8787
